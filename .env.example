# Local Postgres:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/pickleball"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/pickleball"
#
# Supabase — copy both from Dashboard → Connect → Prisma:
# DATABASE_URL = Transaction pooler, port 6543 (Vercel runtime — MUST end in :6543)
# DIRECT_URL   = Session/direct pooler, port 5432 (migrations + local dev only)
#
# Username must be postgres.[project-ref], not just postgres.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30&connect_timeout=15"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres:password@localhost:5432/pickleball"
DIRECT_URL="postgresql://postgres:password@localhost:5432/pickleball"
ADMIN_SESSION_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_APP_NAME="Church Pickleball"
APP_TIMEZONE="America/Chicago"
NEXT_PUBLIC_APP_TIMEZONE="America/Chicago"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="pickleball-images"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-on-first-login"
